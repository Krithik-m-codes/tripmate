# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=                          # MongoDB Atlas connection string (server-only!)

# ─── Auth / App URL Configuration ─────────────────────────────────────────────
# The dev and start scripts listen on 3001; PORT is not read by the app itself.
NEXTAUTH_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXTAUTH_SECRET=                      # Run: openssl rand -base64 32

# Optional OAuth providers. Leave both values blank to hide a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── AI Providers (server-side only — no NEXT_PUBLIC_ prefix) ─────────────────
GEMINI_API_KEY=                       # Google AI Studio → https://aistudio.google.com/app/apikey
NVIDIA_API_KEY=                       # NVIDIA NIM → https://build.nvidia.com
OPENROUTER_API_KEY=                   # OpenRouter → https://openrouter.ai/keys

# ─── Email (Brevo / Sendinblue) ───────────────────────────────────────────────
# Required for verification codes. Without these, sign-up cannot send email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tripmate
BREVO_REPLY_TO=

# ─── Maps ─────────────────────────────────────────────────────────────────────
# Default map styles are open and need no key. A token enables Mapbox features.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=      # Mapbox → https://account.mapbox.com/access-tokens/
# NEXT_PUBLIC_MAPBOX_API_KEY=         # Legacy alias used by src/app/api/index.ts

# ─── Media ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PIXABAY_API_KEY=
NEXT_PUBLIC_LOCATIONIQ_API_KEY=

# ─── Billing (optional) ───────────────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_API_URL=

# ─── Legacy / Optional ────────────────────────────────────────────────────────
# NEXT_PUBLIC_MONGODB_URI=            # Deprecated — use MONGODB_URI above
# NEXT_PUBLIC_GEMINI_API_KEY=         # Deprecated — use GEMINI_API_KEY above
