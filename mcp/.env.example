# Required only for the plan_trip tool.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used by plan_trip.
GEMINI_MODEL=gemini-1.5-flash

# Optional: a contact string sent to OpenStreetMap Nominatim.
# Nominatim asks for a real contact so they can reach you about usage.
TRIPMATE_USER_AGENT=tripmate-mcp/0.1 (+https://github.com/Krithik-m-codes/tripmate)
